{
  "name": "poko-genesis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Giuseppe Vitolo's portfolio: a cinematic, scroll-driven voxel experience starring Poko.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "poko:voxels": "node scripts/export-poko-voxels.ts",
    "poko:blender": "python blender/scripts/build_poko.py && python blender/scripts/validate_glb.py public/assets/poko/poko.glb",
    "cv:sync": "node scripts/sync-cv.mjs",
    "perf": "node scripts/perf/measure.mjs"
  },
  "dependencies": {
    "solid-js": "1.9.15",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  },
  "overrides": {
    "babel-preset-solid": "1.9.15"
  },
  "engines": {
    "node": ">=22.18"
  }
}
